# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
# A server's details for development are never committed.
*.env

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# What the app's native build leaves inside an Expo module it compiles from
# source — a player adapter's, and the app's own in modules/. The adapters
# carried their half of these rules in their own .gitignore until they moved in;
# modules/ never had them, so 98 files of the PiP module's build output were tracked.
adapters/players/*/android/build/
adapters/players/*/android/.gradle/
adapters/players/*/android/.cxx/
modules/*/android/build/
modules/*/android/.gradle/
modules/*/android/.cxx/
*.tsbuildinfo
