{
  // Players draw, so player-kit and the player adapters get React and React
  // Native's types — and the DOM's, for the web engine's <video>. Every other
  // adapter compiles with no host types at all (tsconfig.json).
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["esnext", "dom"],
    "jsx": "react-jsx",
    "types": [],
    "paths": {
      "@sc/api": ["./api/src/index.ts"],
      "@sc/player-kit": ["./player-kit/src/index.ts"]
    }
  },
  "include": ["player-kit/src/**/*.ts", "player-kit/src/**/*.tsx", "players/*/src/**/*.ts", "players/*/src/**/*.tsx"]
}
