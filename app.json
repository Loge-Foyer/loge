{
  "expo": {
    "name": "Loge",
    "slug": "loge",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "loge",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#1b0e0e",
    "ios": {
      "icon": "./assets/loge.icon",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSLocalNetworkUsageDescription": "Loge reaches your media servers and sync server on this network.",
        "UIBackgroundModes": [
          "audio"
        ]
      },
      "bundleIdentifier": "com.fkg.loge",
      "appleTeamId": "UWDGY69RA7"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4a0b14",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "package": "com.fkg.loge"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1b0e0e",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow $(PRODUCT_NAME) to confirm it\u2019s you when a PIN is forgotten."
        }
      ],
      "expo-sharing",
      "expo-asset",
      "expo-video",
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "PORTRAIT_UP"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "usesCleartextTraffic": true
          },
          "ios": {
            "extraPods": [
              {
                "name": "MPVKit",
                "podspec": "https://raw.githubusercontent.com/streamyfin/MPVKit/0.41.0-av5/MPVKit.podspec"
              }
            ]
          }
        }
      ],
      "./config-plugins/with-newest-libcxx",
      "./config-plugins/with-picture-in-picture",
      "./config-plugins/with-scene-lifecycle",
      [
        "@react-native-tvos/config-tv",
        {
          "appleTVImages": {
            "iconSmallLayers": {
              "front": "./assets/tv/icon-front-400x240.png",
              "middle": "./assets/tv/icon-middle-400x240.png",
              "back": "./assets/tv/icon-back-400x240.png"
            },
            "iconSmall2xLayers": {
              "front": "./assets/tv/icon-front-800x480.png",
              "middle": "./assets/tv/icon-middle-800x480.png",
              "back": "./assets/tv/icon-back-800x480.png"
            },
            "iconLayers": {
              "front": "./assets/tv/icon-front-1280x768.png",
              "middle": "./assets/tv/icon-middle-1280x768.png",
              "back": "./assets/tv/icon-back-1280x768.png"
            },
            "topShelf": "./assets/tv/top-shelf-1920x720.png",
            "topShelf2x": "./assets/tv/top-shelf-3840x1440.png",
            "topShelfWide": "./assets/tv/top-shelf-wide-2320x720.png",
            "topShelfWide2x": "./assets/tv/top-shelf-wide-4640x1440.png"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
