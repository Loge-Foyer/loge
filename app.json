{
  "expo": {
    "name": "Streaming Center",
    "slug": "streaming_center_app",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "streamingcenterapp",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSLocalNetworkUsageDescription": "Streaming Center reaches your media servers and sync server on this network.",
        "UIBackgroundModes": [
          "audio"
        ]
      },
      "bundleIdentifier": "com.fkg.streamingcenter",
      "appleTeamId": "UWDGY69RA7"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0e1214",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "package": "com.fkg.streamingcenter"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0e1214",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow $(PRODUCT_NAME) to confirm it\u2019s you when a PIN is forgotten."
        }
      ],
      "expo-sharing",
      "expo-asset",
      "expo-video",
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "PORTRAIT_UP"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "usesCleartextTraffic": true
          },
          "ios": {
            "extraPods": [
              {
                "name": "MPVKit",
                "podspec": "https://raw.githubusercontent.com/streamyfin/MPVKit/0.41.0-av5/MPVKit.podspec"
              }
            ]
          }
        }
      ],
      "./config-plugins/with-newest-libcxx",
      "./config-plugins/with-picture-in-picture"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
