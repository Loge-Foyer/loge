    "@sc/iptv-xtream": "*",
    "@sc/metadata-tmdb": "*",
    "@sc/player-kit": "*",
    "@sc/player-ksplayer": "*",
    "@sc/player-mpv": "*",
    "@sc/player-system": "*",
    "@sc/player-vlc": "*",
    "@sc/source-emby": "*",
    "@sc/source-google-drive": "*",
    "@sc/source-icloud-drive": "*",
    "@sc/source-invidious": "*",
    "@sc/source-jellyfin": "*",
    "@sc/source-mock": "*",
    "@sc/source-onedrive": "*",
    "@sc/source-plex": "*",
    "@sc/source-webdav": "*",
    "@sc/source-yattee": "*",
    "@sc/sync-custom-server": "*",
    "@sc/sync-google-drive": "*",
    "@sc/sync-icloud": "*",
    "@sc/sync-mock": "*",
    "@sc/sync-mock-backup": "*",
    "@sc/sync-onedrive": "*",
    "@shopify/flash-list": "2.0.2",
    "@tamagui/config": "2.7.7",
    "@tamagui/core": "2.7.7",
    "@tamagui/lucide-icons-2": "2.7.7",
    "@tanstack/react-query": "^5.103.2",
    "expo": "~57.0.26",
    "expo-application": "~57.0.3",
    "expo-asset": "~57.0.18",
    "expo-brightness": "~57.0.2",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-local-authentication": "~57.0.3",
    "expo-network": "~57.0.2",
    "expo-router": "~57.0.24",
    "expo-screen-orientation": "~57.0.2",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-video": "~57.0.5",
    "hls.js": "^1.7.3",
    "mpegts.js": "^1.8.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "npm:react-native-tvos@0.86.3-0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "sql.js": "^1.14.2",
    "tamagui": "2.7.7"
  },
  "devDependencies": {
    "@react-native-tvos/config-tv": "^0.1.7",
    "@types/node": "^24",
    "@types/react": "~19.2.2",
    "@types/sql.js": "^1.4.11",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "fake-indexeddb": "^6.2.5",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "node scripts/ios-target.js phone && expo run:ios",
    "ios:device": "node scripts/ios-target.js phone && expo run:ios --configuration Release --no-bundler --device",
    "tvos": "node scripts/ios-target.js tv && EXPO_TV=1 expo run:ios",
    "tvos:device": "node scripts/ios-target.js tv && EXPO_TV=1 expo run:ios --configuration Release --no-bundler --device",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test && npm run typecheck:adapters",
    "test": "vitest run",
    "typecheck:adapters": "tsc --noEmit -p adapters && tsc --noEmit -p adapters/tsconfig.players.json && tsc --noEmit -p adapters/test"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "searchPaths": [
        "./node_modules"
      ],
      "nativeModulesDir": "./modules",
      "exclude": [
        "react-native-tvos"
      ]
    }
  },
  "workspaces": [
    "adapters/api",
    "adapters/player-kit",
    "adapters/sources/*",
    "adapters/iptv/*",
    "adapters/players/*",
    "adapters/sync/*",
    "adapters/metadata/*"
  ],
  "overrides": {
    "react-native": "$react-native"
  }
}
