{
  // api and the plugins run on Hermes and in browsers, and take everything
  // host-side from their context: this program sees no host types at all.
  // The tests are a program of their own (test/tsconfig.json), with Node's.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": []
  },
  "include": [
    "api/src/**/*.ts",
    "plugins/*/*/src/**/*.ts"
  ]
}
